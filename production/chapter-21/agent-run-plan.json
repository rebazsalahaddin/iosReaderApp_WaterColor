    {
      "page": "c21-s02-p07",
      "assets": [
        "CH21_B01:ONE",
        "CH21_S01:R",
        "CH02_S05:L"
      ],
      "story_text": "\"See that wheat? I don't eat bread, so it means nothing to me. But your hair is gold. If you tame me, the wheat will remind me of you. I'll love the wind in it.\"",
      "assembly_instructions": "story-and-continuity/chapter-21/page-compositions/c21-s02-p07/ASSEMBLY.md",
      "layout": "story-and-continuity/chapter-21/page-compositions/c21-s02-p07/layout.json",
