        "CH21_S01:R": "V_CH21_S01_R",
        "CH02_S05:L": "V_CH02_S05_L"
      }
    },
    {
      "page": "c21-s02-p08",
      "assets": [
        "CH21_B01:ONE",
        "CH21_S01:R",
        "CH02_S05:L"
      ],
      "story_text": "The fox watched him for a long time. \"Please. Tame me.\"",
      "assembly_instructions": "story-and-continuity/chapter-21/page-compositions/c21-s02-p08/ASSEMBLY.md",
      "layout": "story-and-continuity/chapter-21/page-compositions/c21-s02-p08/layout.json",
