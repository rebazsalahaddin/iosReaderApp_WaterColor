    },
    {
      "page": "c21-s02-p06",
      "assets": [
        "CH21_B01:ONE",
        "CH21_S01:R",
        "CH02_S02:L"
      ],
      "story_text": "\"But your steps could become different. Other steps send me running into my hole. Yours would call me out, like music. My whole life would grow brighter.\"",
      "assembly_instructions": "story-and-continuity/chapter-21/page-compositions/c21-s02-p06/ASSEMBLY.md",
      "layout": "story-and-continuity/chapter-21/page-compositions/c21-s02-p06/layout.json",
